# LLM Provider configuration (Session 2 — kept for backwards compatibility)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai

# Default model for the configured provider. Can be overridden per request via
# the "model" field in POST /api/v1/estimate (handy for live A/B comparisons
# without restarting the server).
LLM_MODEL=gpt-4o-mini

# Application
APP_ENV=development
LOG_LEVEL=DEBUG

# --- Session 3 — LiteLLM wrapper ----------------------------------------------
# The wrapper tries PRIMARY_MODEL first and falls back to FALLBACK_MODEL on
# failure, with up to LLM_RETRIES attempts and an LLM_TIMEOUT-second deadline.
PRIMARY_MODEL=gpt-4o-mini
FALLBACK_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT=30
LLM_RETRIES=2

# --- Session 3 — Redis exact-match cache --------------------------------------
# Inside docker-compose, REDIS_URL is overridden to redis://redis:6379.
# When running uvicorn locally (outside Docker), use redis://localhost:6379.
REDIS_URL=redis://redis:6379
CACHE_TTL=86400

# --- Session 3 — Streamlit transport ------------------------------------------
# Streamlit hits the FastAPI service over HTTP. Point this to wherever the
# estimator is reachable from the machine running streamlit_app.py.
ESTIMATOR_API_BASE_URL=http://localhost:8000

# --- Session 15 — Inter-service authentication ---------------------------------
# Shared secret for service-to-service calls. When set, the AI service requires
# the X-Service-Token header on estimation endpoints. Streamlit (and any future
# business-backend) must include this token in its requests.
# Leave empty to disable authentication (development mode).
# CHANGE IN PRODUCTION — generate with: openssl rand -hex 32
SERVICE_TOKEN=

# --- Session 4 — Semantic cache (redisvl + embeddings) ------------------------
# Cosine similarity threshold (0..1) above which a stored estimation is served
# as a cache hit. 0.92 is conservative; lower threshold = more recall, more
# false positives. Affines with the chosen embedding model.
EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_CACHE_THRESHOLD=0.85
SEMANTIC_CACHE_TTL=86400
# When true, the cache logs would-be hits but does NOT serve them — useful to
# calibrate the threshold against production traffic before flipping on.
SEMANTIC_CACHE_LOG_ONLY=false

# --- Session 6 — Postgres + Ingestion -----------------------------------------
# Postgres (image: pgvector/pgvector:pg16). In Session 6 we use it for the
# pseudonymization mapping table and ingestion job tracking only. The pgvector
# extension is NOT activated yet (no ``CREATE EXTENSION vector``); Session 7
# will add a migration that turns it on.
# Inside docker-compose, DATABASE_URL is overridden to postgres:5432. When
# running uvicorn locally (outside Docker), use localhost:5433 (host-mapped).
DATABASE_URL=postgresql+psycopg://estimator:estimator@postgres:5432/estimator

# Path to the data-source catalog (YAML). Loaded once at startup, validated
# with Pydantic. ``include`` decisions drive the ingestion endpoint.
CATALOG_PATH=data/catalog/catalog.yaml

# Root folder where the catalog ``location`` entries are resolved against.
INGESTION_DATA_ROOT=data/seed

# spaCy model that Presidio uses to detect PERSON/LOC entities. Without an
# explicit Spanish model, Presidio defaults to English and SILENTLY misses
# Hispanic names — a teaching moment in the live session.
PRESIDIO_SPACY_MODEL=es_core_news_md

# Faker locale for generating pseudonyms (names, emails, …).
PSEUDONYM_FAKER_LOCALE=es_ES

# HMAC salt used to derive the ``original_hash`` stored in pseudonym_mappings.
# Rotating this salt invalidates all prior mappings — that is the lever for
# GDPR Art. 17 'right to be forgotten' at the corpus level. CHANGE IN PROD.
PSEUDONYM_HASH_SALT=change-me-in-prod

# --- Prompts ---
# Active prompt template version. Must match a folder under src/prompts/estimation/.
# Useful for A/B testing: run v1 in production, v2 in staging.
PROMPT_VERSION=vX