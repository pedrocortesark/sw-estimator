# --- LLM Provider ---
# Which LLM provider to use: "openai" or "anthropic"
LLM_PROVIDER=anthropic

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
