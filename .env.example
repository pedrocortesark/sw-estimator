# --- LLM Provider ---
# Which LLM provider to use: "openai" or "anthropic"
LLM_PROVIDER=anthropic

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Prompts ---
# Active prompt template version. Must match a folder under src/prompts/estimation/.
# Useful for A/B testing: run v1 in production, v2 in staging.
# PROMPT_VERSION=v1

# --- Conversation ---
# Maximum number of user/assistant turn pairs kept in the sliding window.
# The system prompt is always preserved and does not count toward this limit.
# MAX_CONVERSATION_TURNS=6

# --- Cache ---
REDIS_URL=redis://localhost:6380