@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudText Typo="Typo.h6" Class="ml-3">SW Estimator</MudText>
        <MudSpacer />
        <MudText Typo="Typo.caption" Class="mr-3" Style="opacity:0.7">AI-powered effort estimation</MudText>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-10">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
